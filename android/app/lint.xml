<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- ICU4J is a test library of :core's (core/build.gradle.kts), which lint now reaches through :app; the app
         doesn't ship it, and :core keeps its version. -->
    <issue id="NewerVersionAvailable">
        <ignore regexp="com\.ibm\.icu:icu4j" />
    </issue>
    <!-- Settings offers the app's languages from Android 13 (res/xml/locales_config.xml); older versions have no such
         list and ignore it. The back goes through the windows' callbacks from Android 13, predictive from 14
         (AndroidManifest.xml); older versions send the old back, which the same back handlers take, and ignore it. -->
    <issue id="UnusedAttribute">
        <ignore regexp="localeConfig" />
        <ignore regexp="enableOnBackInvokedCallback" />
    </issue>
    <!-- A sheet's grabber says what it is and does in Material's words for a bottom sheet's drag handle (ui/sheet/Sheet.kt),
         which come in the system's languages as UIKit's do; Material keeps them private, and a release that renamed
         them would stop the build rather than the grabber. -->
    <issue id="PrivateResource">
        <ignore regexp="m3c_bottom_sheet_" />
    </issue>
</lint>
