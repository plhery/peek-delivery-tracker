<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The API, sign-in, the carrier catalog and parcel links (platform/OkHttpTransport.kt). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Haptics at the iPhone's intensities (VibrationEffect compositions, Haptics.kt). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Backups carry the preferences and the parcels this phone follows, never the secrets or the caches
         (res/xml/data_extraction_rules.xml). -->
    <application
        android:name=".PeekApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Peek">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Peek.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The account's export, handed to the share sheet (CacheExportFiles). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/exports" />
        </provider>
    </application>

</manifest>
