<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The API, sign-in, the carrier catalog and parcel links (platform/OkHttpTransport.kt). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Haptics at the iPhone's intensities (VibrationEffect compositions, Haptics.kt). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The label scanner, asked for as it first opens, as the iPhone's camera is (platform/CameraLabelScanner.kt).
         A device without a camera on its back still takes the app, without the scanner. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Notifications, asked for from Android 13 by the invitation, Delivery updates' switch or a parcel followed
         without an account, never at launch (platform/Notifications.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- Which browser web sign-in opens in, and whether it has an Auth Tab (platform/CustomTabSignIn.kt): the browsers,
         and those offering Custom Tabs, which Android shows an app only when it asks for them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <!-- Backups carry the preferences and the parcels this phone follows, never the secrets or the caches
         (res/xml/data_extraction_rules.xml).
         Left to right on a phone set to a right-to-left language, as the iPhone app stays: it has no right-to-left
         copy and shows English there. Without RTL support the views Android draws in the app's windows (the splash,
         text selection's toolbar, dialogs' frames) agree with the screens, which PeekTheme lays out left to right.
         Settings offers the app's languages for it (res/xml/locales_config.xml).
         The app's icon, the iPhone's (res/mipmap-anydpi/ic_launcher.xml), is round launchers' too, and the share
         sheet's beside "Add to Peek".
         Each window takes a change of the night mode itself (configChanges="uiMode"), the notifications' alias as the
         window it stands for: the app's own night follows its appearance and is set as the appearance store is made,
         which can be in any of them the first time after an update, a data clear or a restore, and the phone's can
         change while one is up. None starts again for it, flashes or loses its intent.
         The back is predictive on every version that has it, as it is by default from Android 16: the system's
         gesture drives the windows' OnBackPressedDispatcher (Compose's BackHandler and PredictiveBackHandler), so a
         page, a sheet or a pushed settings page follows the finger from Android 14, and leaving the app shows the
         home screen behind it. No window takes the back any other way. -->
    <application
        android:name=".PeekApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.Peek">
        <!-- The keyboard never pans the window: the screens make room for it from its insets, and the tab bar stays
             where it is, behind it, as the iPhone's does. A parcel's link brings the window forward already open
             (singleTop), through ParcelLinkActivity. The night mode, which follows the app's appearance, changes
             without making the window again (MainActivity.onConfigurationChanged). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Peek.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The app's own links to one of the deliveries, peekdeliverytracker://parcel/<uuid>, to the deliveries,
                 peekdeliverytracker://parcels, to a friend, peekdeliverytracker://friend/<uuid>, and to Add filled
                 with a tracking number, peekdeliverytracker://add?tracking=<text>. Android matches the scheme as
                 written, where the iPhone takes it in any case. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="peekdeliverytracker" />
                <data android:host="parcel" />
                <data android:host="parcels" />
                <data android:host="friend" />
                <data android:host="add" />
            </intent-filter>
            <!-- The shortcuts on the app's icon: "Add a parcel" (res/xml/shortcuts.xml), and the next delivery, which the
                 app publishes (LauncherShortcuts). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Web sign-in's window, over the app's: it opens the provider's page above itself, in the app's task, in the
             browser's Auth Tab, which answers it, or else in a Custom Tab, and then ends the sign-in as it comes back
             to the top, with the address SignInCallbackActivity brought it or, without one, as cancelled
             (platform/CustomTabSignIn.kt). It shows nothing of its own. -->
        <activity
            android:name=".platform.SignInTabActivity"
            android:configChanges="uiMode"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Where the sign-in page sends a Custom Tab back, peekdeliverytracker://auth-callback, the iPhone's
             ASWebAuthenticationSession's callback (an Auth Tab takes it itself): it hands the address to
             SignInTabActivity, which closes the tab, and closes, showing nothing and leaving nothing in Recents. A link
             to it while no sign-in waits ends nothing but still closes the tab, and it is never a link the app opens or
             counts. -->
        <activity
            android:name=".platform.SignInCallbackActivity"
            android:configChanges="uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="peekdeliverytracker" />
                <data android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- What a notification the app posted opens: the window itself, under a name no other app can start (not
             exported, no intent filter), so a route comes to the window from the app's own notifications alone
             (platform/AppNotifications.kt). Android matches FLAG_ACTIVITY_CLEAR_TOP and singleTop on the activity an
             alias stands for, so a notification opened brings the window already open forward with it. -->
        <activity-alias
            android:name=".NotificationOpening"
            android:exported="false"
            android:targetActivity=".MainActivity" />

        <!-- A parcel someone shared, which opens in its sheet, and a friend's invitation, which shows over the app: it
             hands the link to the app in memory and opens the app's window without it, showing nothing itself, in a
             task of its own that Recents neither shows nor keeps, so a parcel's owner key is written nowhere
             (ParcelLinkActivity). -->
        <activity
            android:name=".ParcelLinkActivity"
            android:configChanges="uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <!-- In the app's scheme: peekdeliverytracker://p/<id> and peekdeliverytracker://invite#<code>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="peekdeliverytracker" />
                <data android:host="p" />
                <data android:host="invite" />
            </intent-filter>
            <!-- On the site, https://<the site>/p/<id>, /i/<id> and /invite#<code> (or /invite/#<code>), and on the
                 host it answered on before (the iPhone's associated domains, SDT_ASSOCIATED_DOMAIN and
                 SDT_ASSOCIATED_DOMAIN_LEGACY): an App Link. Android verifies each host against its
                 /.well-known/assetlinks.json, which names this package and the SHA-256 fingerprint of the key the app
                 is signed with (the user's signing key, or Play's if Play signs the app). Until a host serves that
                 file, Android opens that host's addresses in the browser. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="${linkHost}" />
                <data android:host="${linkHostLegacy}" />
                <data android:pathPrefix="/p/" />
                <data android:pathPrefix="/i/" />
                <data android:path="/invite" />
                <data android:path="/invite/" />
            </intent-filter>
        </activity>

        <!-- "Add to Peek" in the share sheet, in the phone's language (share_title, written at build time from the
             shared copy), with the app's icon: the iPhone's share extension, which takes text and a web link, both of
             which come here as plain text. Its card stands over the app that shared, in that app's task; where the
             share starts a task, the card's own task (an empty `taskAffinity`) stays out of Recents and out of the
             app's (ShareActivity). -->
        <activity
            android:name=".ShareActivity"
            android:configChanges="uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_title"
            android:taskAffinity=""
            android:theme="@style/Theme.Peek.Share">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The home screen widget (NextDeliveryWidget), and the refresh its alarm sends it (DeliveryWidgetUpdates). -->
        <receiver
            android:name=".widget.NextDeliveryWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_gallery_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_delivery_widget" />
        </receiver>

        <!-- The list widget (ParcelsWidget), next to it. -->
        <receiver
            android:name=".widget.ParcelsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_list_gallery_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/parcels_widget" />
        </receiver>

        <!-- The app a parcel's link went to through the share sheet (ShareTargetChosen): the share sheet alone sends to
             it, through the PendingIntent the app gave it. -->
        <receiver
            android:name=".platform.ShareTargetChosen"
            android:exported="false" />

        <!-- The account's export, handed to the share sheet (CacheExportFiles). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/exports" />
        </provider>

        <!-- The pushes, through Firebase Cloud Messaging (platform/FirebasePush.kt): their data and each new token
             come to PeekMessagingService from Firebase's own receiver inside the app, so the service isn't exported.
             The app starts Firebase itself, from the build's settings (PeekApplication), so Firebase's start-up
             provider, which looks for google-services.json's resources, is removed; and Firebase makes no token
             before the app asks for one (automatic initialization off), so a build without pushes, or a phone that
             never turns them on, tells Google nothing. -->
        <service
            android:name=".platform.PeekMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />

        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <!-- The label scanner's ML Kit logs its use (the device, the app's and its own versions, timings, error codes;
             never a frame or a barcode) through Google's data transport, whose CCT backend would send it to Google,
             where the iPhone's DataScanner sends nothing of the app's. Without that backend the transport finds
             nowhere to send and drops each batch (platform/CameraLabelScanner.kt), Firebase Cloud Messaging's too.
             The backend's classes stay: ML Kit links them. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>
    </application>

</manifest>
