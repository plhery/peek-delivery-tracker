<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The API, sign-in, the carrier catalog and parcel links (platform/OkHttpTransport.kt). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Haptics at the iPhone's intensities (VibrationEffect compositions, Haptics.kt). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".PeekApplication"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Peek">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Peek.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
