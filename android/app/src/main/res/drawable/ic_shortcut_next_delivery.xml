<?xml version="1.0" encoding="utf-8"?>
<!-- The next delivery's shortcut's icon (LauncherShortcuts), for the iPhone's box.truck: the glyph in the mark's ink
     on its yellow, as the app's icon is drawn, so that it reads the same in a light popup and a dark one. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/mark_yellow" />
    <foreground android:drawable="@drawable/ic_shortcut_next_delivery_glyph" />
    <monochrome android:drawable="@drawable/ic_shortcut_next_delivery_glyph" />
</adaptive-icon>
