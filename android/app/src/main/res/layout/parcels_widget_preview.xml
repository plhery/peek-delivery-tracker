<?xml version="1.0" encoding="utf-8"?>
<!-- The list widget's gallery preview before Android 15, and its first look until it has drawn: the outline of its four
     cells by two, two columns of faint rows on the app's page, each a symbol beside a name over a line, which reads the
     same in every language. Only views RemoteViews inflates. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/parcels_widget_page"
    android:baselineAligned="false"
    android:clipToOutline="true"
    android:orientation="horizontal"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/parcels_widget_line" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="9dp"
                    android:background="@drawable/parcels_widget_line" />

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="7dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/parcels_widget_line" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_marginTop="5dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/parcels_widget_line" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="78dp"
                    android:layout_height="9dp"
                    android:background="@drawable/parcels_widget_line" />

                <FrameLayout
                    android:layout_width="82dp"
                    android:layout_height="7dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/parcels_widget_line" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_marginTop="5dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/parcels_widget_line" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="108dp"
                    android:layout_height="9dp"
                    android:background="@drawable/parcels_widget_line" />

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="7dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/parcels_widget_line" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/parcels_widget_line" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="9dp"
                    android:background="@drawable/parcels_widget_line" />

                <FrameLayout
                    android:layout_width="70dp"
                    android:layout_height="7dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/parcels_widget_line" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_marginTop="5dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/parcels_widget_line" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="102dp"
                    android:layout_height="9dp"
                    android:background="@drawable/parcels_widget_line" />

                <FrameLayout
                    android:layout_width="60dp"
                    android:layout_height="7dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/parcels_widget_line" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="31dp"
            android:layout_marginTop="5dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="20dp"
                android:layout_height="15dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/parcels_widget_line" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="70dp"
                    android:layout_height="9dp"
                    android:background="@drawable/parcels_widget_line" />

                <FrameLayout
                    android:layout_width="76dp"
                    android:layout_height="7dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/parcels_widget_line" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
