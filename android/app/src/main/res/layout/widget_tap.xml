<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's page, behind its cards, passes or rows, which opens the list (PageTap), as WidgetKit's page does: not
     an item of its own for TalkBack, as the iPhone's isn't one for VoiceOver; its cards, passes and rows are. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tap"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no" />
