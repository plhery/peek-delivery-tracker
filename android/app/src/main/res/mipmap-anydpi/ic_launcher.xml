<?xml version="1.0" encoding="utf-8"?>
<!-- The app's icon, the iPhone's AppIcon.png: the mark's eyes on its yellow, which fills the square for the launcher to
     mask to its shape, as iOS masks the icon to its own. Android 13 and later tint the eyes alone for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/mark_yellow" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
