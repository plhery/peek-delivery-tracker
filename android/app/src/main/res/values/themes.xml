<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window behind the app: iOS's LaunchBackground, whatever the appearance. The platform's own pieces (the
         text selection's toolbar, its menus and dialogs) take the theme's light or dark, which follows the app's
         appearance as the app's night mode does (values-night), as iOS's follow the window's override. The bars'
         icons as MainActivity sets them, dark over the light app (light in values-night), are set here so that the
         launch's (Theme.Peek.Starting), which the window's theme is laid over, don't come back on a change of the
         night. -->
    <style name="Theme.Peek" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- The share card's window (ShareActivity): see-through, over the app that shared, with no motion of its own, as
         the card's sheet comes up and goes down itself; light in either appearance, as the card is. -->
    <style name="Theme.Peek.Share" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- The launch: the same blank background and no icon, as iOS's UILaunchScreen. The bars' icons are dark over it
         in either night, defined here alone for every configuration: the starting window takes the app's night, which
         follows its appearance and may be dark on a light phone, where Theme.SplashScreen (DayNight) would turn them
         white over the light background. iOS's status bar follows the phone over its launch screen, which Android can
         no longer read once the app's night stands in for it. -->
    <style name="Theme.Peek.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/launch_blank</item>
        <item name="postSplashScreenTheme">@style/Theme.Peek</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
