<?xml version="1.0" encoding="utf-8"?>
<!--
    What leaves the phone in a backup or a transfer to a new one. The iPhone's carry its UserDefaults and Application
    Support, and leave behind the keychain items it keeps on this device alone. Here the preferences and the parcels
    this phone follows (DeviceParcels/) go; the secrets never do (Keychain/: the session, owner keys, attestation
    records, sealed with a key of this phone's Keystore, which stays behind). On the new phone the parcels followed
    through someone else's link come back, and this phone's own, whose keys stayed, are dropped
    (DeviceParcelFiles.matched). Each account's cache (ParcelCache/) stays too, where the iPhone's goes with
    Application Support: it holds what an account showed. The cache folder never goes.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="Keychain/" />
        <exclude domain="file" path="ParcelCache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="Keychain/" />
        <exclude domain="file" path="ParcelCache/" />
    </device-transfer>
</data-extraction-rules>
