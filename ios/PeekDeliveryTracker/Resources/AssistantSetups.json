{
  "setups": [
    {
      "name": "Claude",
      "who": [
        "assistants.setup.claude.who",
        {
          "organization": "Organization settings › Connectors",
          "browse": "Browse connectors",
          "team": "Add to your team"
        }
      ],
      "steps": [
        [
          "assistants.setup.claude.open",
          {
            "listing": {
              "text": "Peek Parcel Tracker",
              "href": "https://claude.ai/directory/peek-parcel-tracker"
            },
            "connectors": "Customize › Connectors",
            "plus": "+"
          }
        ],
        [
          "assistants.setup.claude.add",
          {
            "connect": "Connect"
          }
        ],
        [
          "assistants.setup.claude.use",
          {
            "plus": "+",
            "connectors": "Connectors"
          }
        ]
      ],
      "fallback": [
        "assistants.setup.claude.custom",
        {
          "connectors": "Customize › Connectors",
          "new": "+ Add",
          "custom": "Add custom connector",
          "continue": "Continue",
          "add": "Add"
        }
      ]
    },
    {
      "name": "ChatGPT",
      "who": [
        "assistants.setup.chatgpt.who"
      ],
      "steps": [
        [
          "assistants.setup.chatgpt.open",
          {
            "plugins": "chatgpt.com/plugins",
            "plus": "+",
            "custom": "Add custom MCP server"
          }
        ],
        [
          "assistants.setup.chatgpt.add",
          {
            "oauth": "OAuth",
            "accept": "I understand and want to continue",
            "create": "Create as a plugin"
          }
        ],
        [
          "assistants.setup.chatgpt.use",
          {
            "plus": "+"
          }
        ]
      ]
    },
    {
      "name": "Gemini",
      "who": [
        "assistants.setup.gemini.who"
      ],
      "steps": [
        [
          "assistants.setup.gemini.open",
          {
            "settings": "Settings",
            "apps": "Connected Apps"
          }
        ],
        [
          "assistants.setup.gemini.add",
          {
            "custom": "Custom apps",
            "next": "Next"
          }
        ],
        [
          "assistants.setup.gemini.use"
        ]
      ]
    },
    {
      "name": "OpenClaw",
      "who": [
        "assistants.setup.openclaw.who"
      ],
      "steps": [
        [
          "assistants.setup.openclaw.open",
          {
            "stop": {
              "command": "openclaw gateway stop"
            },
            "set": {
              "command": "openclaw mcp set peek '{\"url\":\"{{address}}\",\"transport\":\"streamable-http\",\"auth\":\"oauth\"}'"
            }
          }
        ],
        [
          "assistants.setup.openclaw.add",
          {
            "login": {
              "command": "openclaw mcp login peek"
            }
          }
        ],
        [
          "assistants.setup.openclaw.use",
          {
            "start": {
              "command": "openclaw gateway start"
            }
          }
        ]
      ],
      "fallback": [
        "assistants.setup.openclaw.remote"
      ]
    },
    {
      "name": "Home Assistant",
      "who": [
        "assistants.setup.homeAssistant.who"
      ],
      "steps": [
        [
          "assistants.setup.homeAssistant.open",
          {
            "marketplace": "Settings › Marketplace",
            "link": "Add from link",
            "repository": "https://github.com/plhery/peek-ha",
            "add": "Add",
            "setUp": "Set up"
          }
        ],
        [
          "assistants.setup.homeAssistant.use",
          {
            "addCard": "Add card",
            "byCard": "By card",
            "card": "Peek parcels"
          }
        ]
      ]
    }
  ]
}
