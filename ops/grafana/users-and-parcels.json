    {
      "type": "timeseries",
      "id": 17,
      "title": "Parcels, all time",
      "description": "Running total of the parcels added, to the end of each UTC day.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "select time, \"With an account\", \"Without an account\"\nfrom (\n  select day, (day::timestamp at time zone 'UTC') as time,\n    sum(parcels_added_account) over (order by day) as \"With an account\",\n    sum(parcels_added_lookup) over (order by day) as \"Without an account\"\n  from metrics.daily\n) as total\nwhere $__timeFilter(day)\norder by 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "With an account"
            },
            "properties": [
              {
                "id": "color",
