    {
      "type": "barchart",
      "id": 18,
      "title": "Being tracked, by stage",
      "description": "Parcels being tracked now, with or without an account, by their stage.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "select case stage\n    when 'pending' then 'Added to tracking'\n    when 'registered' then 'Label created'\n    when 'accepted' then 'Received by carrier'\n    when 'in_transit' then 'In transit'\n    when 'customs' then 'At customs'\n    when 'exception' then 'Needs attention'\n    when 'out_for_delivery' then 'Out for delivery'\n    when 'failed_attempt' then 'Delivery attempted'\n    when 'ready_for_pickup' then 'Ready for pickup'\n    else stage end as stage,\n  account + lookup as parcels\nfrom metrics.open_parcels\norder by array_position(array['pending', 'registered', 'accepted', 'in_transit', 'customs',\n  'exception', 'out_for_delivery', 'failed_attempt', 'ready_for_pickup'], open_parcels.stage)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#3987e5"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xField": "stage",
        "showValue": "always",
        "text": {
          "valueSize": 12
        },
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
