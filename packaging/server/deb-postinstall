#!/bin/sh
set -eu
name='@PACKAGE_NAME@'
if ! getent group "$name" >/dev/null; then addgroup --system "$name"; fi
if ! getent passwd "$name" >/dev/null; then adduser --system --ingroup "$name" --home "/var/lib/$name" --no-create-home --disabled-login "$name"; fi
install -d -o "$name" -g "$name" -m 0750 "/var/lib/$name" "/var/log/$name"
install -d -o root -g root -m 0755 "/var/cache/$name"
for directory in "/var/cache/$name/next" "/var/cache/$name/browser"; do
  if [ -L "$directory" ]; then
    echo "Refusing a symlink at $directory" >&2
    exit 1
  fi
  install -d -o "$name" -g "$name" -m 0750 "$directory"
done
chown root:"$name" "/etc/$name/server.env"
chmod 0640 "/etc/$name/server.env"
if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
  systemctl daemon-reload
  if [ -f "/run/$name.was-running" ]; then
    rm "/run/$name.was-running"
    systemctl start "$name.service"
  fi
fi
