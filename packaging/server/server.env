# Configure your own Supabase stack and apply the server's database migrations
# before enabling the service. This file uses Node's dotenv syntax, not shell.
HOSTNAME=127.0.0.1
PORT=3000
SUPABASE_URL=
SUPABASE_PUBLIC_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_APPLE_ENABLED=false
NEXT_PUBLIC_AUTH_EMAIL_OTP_ENABLED=true
